# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DEBUG=true
ALLOW_DEV_SESSION_BOOTSTRAP=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL 16
POSTGRES_DB=nivasops
POSTGRES_USER=nivasops
POSTGRES_PASSWORD=nivasops
DATABASE_URL=postgresql://nivasops:nivasops@127.0.0.1:5432/nivasops
DATABASE_CONN_MAX_AGE=0

# JWT defaults are suitable only for local development. Production uses an asymmetric key.
JWT_ALGORITHM=HS256
JWT_ISSUER=nivasops-api
JWT_AUDIENCE=nivasops-clients

# For Azure PostgreSQL with Entra authentication, use scripts/run-api-azure.ps1.
# Never save PGPASSWORD or an Entra access token in this file.
PGSSLMODE=require
PGCONNECT_TIMEOUT=10

# Required by pytest through config.settings_test. This must be a dedicated,
# isolated Azure PostgreSQL database name beginning with test_ or a NivasOps
# name containing test, such as nivasopstestdb.
TEST_PGDATABASE=

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Background jobs remain synchronous during Phase 0.
CELERY_TASK_ALWAYS_EAGER=true

# Local Redis fallback.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CACHE_URL=redis://127.0.0.1:6379/2

# Azure Cache for Redis override. Never commit the access key.
# When host and key are set, TLS URLs for databases 0, 1, and 2 are built in memory.
AZURE_REDIS_HOST=
AZURE_REDIS_PORT=6380
USE_AZURE_REDIS=false
AZURE_REDIS_ACCESS_KEY=

# Communications & Email Delivery (Options: disabled, console, azure_communication_services)
PUBLIC_AUTH_EMAIL_BACKEND=disabled
ACS_EMAIL_ENDPOINT=
ACS_EMAIL_SENDER=

# Ticket Completion Delivery & Key Vault
TICKET_COMPLETION_EMAIL_BACKEND=disabled
TICKET_COMPLETION_CAPSULE_BACKEND=disabled
TICKET_COMPLETION_KEY_VAULT_URL=
TICKET_COMPLETION_CAPSULE_TEST_MODE=false

# Media & Ticket Attachment Storage (Options: disabled, test, azure_blob)
TICKET_ATTACHMENT_STORAGE_BACKEND=disabled
TICKET_ATTACHMENT_STORAGE_TEST_MODE=false
TICKET_ATTACHMENT_MAX_BYTES=20971520
TICKET_ATTACHMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf
TICKET_ATTACHMENT_UPLOAD_URL_EXPIRY_SECONDS=900
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_BLOB_ENDPOINT=